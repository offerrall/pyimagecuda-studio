      "type": "ConditionalNode",
      "name": "IF BITCOIN > 50.000",
      "position": {
        "x": 37.39999999999998,
        "y": 253.14999999999998
      },
      "parameters": {
        "code": "import requests\n\ndef condition():\n    # Get Bitcoin price from API\n    try:\n        response = requests.get('https://api.coinbase.com/v2/prices/BTC-USD/spot')\n        price = float(response.json()['data']['amount'])\n        print(f\"Bitcoin price: ${price}\")\n        \n        # Use input_1 if BTC > $50,000, else input_2\n        return price > 50000\n    except:\n        print(\"API call failed, defaulting to False\")\n        return False",
        "invert": false
      }
    },
